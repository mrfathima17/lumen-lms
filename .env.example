# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Colombo
SECURE_SSL_REDIRECT=False   # set True once HTTPS is in front of the site
TRUST_PROXY_HEADERS=True    # True only behind our own nginx

DB_NAME=lumen
DB_USER=lumen
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_HOST=127.0.0.1
DB_PORT=3306

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Lumen <no-reply@your-domain.example>
BACKUP_DIR=/var/backups/lumen   # outside the web root and the media folder

# Background jobs and email
REDIS_URL=redis://127.0.0.1:6379/0   # docker-compose overrides this to the redis service
CELERY_EAGER=False                   # True runs jobs inside the web request: development without Redis only
SITE_URL=https://lms.your-domain.example   # used for links in emails
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# For real email also set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
