# Use instead of docker/nginx.conf once you have a certificate (for example from Let's Encrypt).
# 1. Replace lms.your-domain.example below.
# 2. In docker-compose.yml, mount this file over /etc/nginx/conf.d/default.conf, add "443:443" to the nginx ports
#    and mount your certificates, for example:   - /etc/letsencrypt:/etc/letsencrypt:ro
# 3. Keep SECURE_SSL_REDIRECT=True in .env.
server {
    listen 80;
    server_name lms.your-domain.example;
    location = /healthz/ { proxy_pass http://web:8000; proxy_set_header Host $host; }
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name lms.your-domain.example;
    ssl_certificate     /etc/letsencrypt/live/lms.your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lms.your-domain.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 25m;

    # Uploaded files: reachable only through Django's X-Accel-Redirect after it has checked who is asking.
    location /media/ { alias /app/media/; internal; }

    location / {
        proxy_pass http://web:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # $remote_addr, not $proxy_add_x_forwarded_for: a visitor must not be able to invent their own IP for the network rules.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
